# Copy to .env (which is git-ignored). Placeholders only: never put a real key in this file.
# With nothing set, the app runs on the local Ollama model and needs no key at all.

# --- Provider ---------------------------------------------------------------
# auto | ollama | hackclub | nvidia. "auto" picks by the key prefix, else ollama.
LLM_PROVIDER=auto
# Your OWN key for the hosted provider (Hack Club keys start with sk-hc-v1-). Optional.
LLM_API_KEY=sk-hc-v1-your-key-here
# Optional overrides for the primary provider.
LLM_BASE_URL=
LLM_MODEL=
# Optional free NVIDIA Build key, used as a fallback (starts with nvapi-).
NVIDIA_API_KEY=

# --- Per-role model overrides (primary provider only; must be on the allow-list) ---
MASTER_MODEL=
WORKER_MODEL=
ADVOCATE_MODEL=
CRITIC_MODEL=
CHAIR_MODEL=

# --- Local model --------------------------------------------------------------
# docker compose sets OLLAMA_BASE_URL itself; change it only when running without Docker.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Comma-separated extra open-weight model IDs you want to allow (you vouch they are open-weight).
EXTRA_OPEN_WEIGHT_MODELS=

# --- Panel and gates ----------------------------------------------------------
# auto | full | single. auto = single on the local model, full on hosted models.
PANEL_MODE=auto
# 1 or 2 debate rounds (2 adds one rebuttal each).
DEBATE_ROUNDS=1
WAITLIST_TARGET=100
WAITLIST_DAYS=14
MIN_SOURCED_CLAIMS=3

# --- Budget -------------------------------------------------------------------
# Stop using the metered hosted provider once today's spend reaches this (USD).
DAILY_BUDGET_USD=2.50

# --- Web ----------------------------------------------------------------------
PORT=8000
